<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AppAssemblyPath Condition="'$(AppAssemblyPath)' == ''">../../../PureRDP/bin/Release/net10.0-windows/PureRDP.dll</AppAssemblyPath>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="PureRDP"><HintPath>$(AppAssemblyPath)</HintPath></Reference>
    <Reference Include="MSTSCLib"><HintPath>../../../PureRDP/Platform/MSTSCLib.dll</HintPath></Reference>
    <Reference Include="AxMSTSCLib"><HintPath>../../../PureRDP/Platform/AxMSTSCLib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
